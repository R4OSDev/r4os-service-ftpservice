R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=FTPSVC
VERSION=0.1.10
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ZIG_MODULE=path_text:../../Libraries/R4STD/Bindings/Zig/path_text.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/FTPSVC.R4X
IMAGE_SCOPE=full
IMPORT=R4SYS:Query2:2
IMPORT=R4NET:Query2:2
META=memory.profile=service
META=memory.tag=ftp
META=service.name=FTPSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
